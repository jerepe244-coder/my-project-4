# ==============================================================================
# ZYRVAE Intelligence Dashboard — Environment Variables Configuration
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings > Environment Variables.
# NEVER commit .env, .env.local or real API credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE VARIABLES (Requeridas para LIVE READ-ONLY)
# ------------------------------------------------------------------------------

# URL base de la instancia n8n Cloud (Server-side ONLY).
# Predeterminado: https://zyrvae.app.n8n.cloud
N8N_BASE_URL=https://zyrvae.app.n8n.cloud

# API Key de n8n Cloud generada en Settings > n8n API.
# Requerida para consultar las Data Tables en modo LIVE READ-ONLY.
# NUNCA agregue prefijo NEXT_PUBLIC_ ni comparta este secreto en repositorios.
N8N_API_KEY=

# Control de Modo de Operación:
# true  = Modo DEMO (predeterminado seguro, aislamiento absoluto con datos sintéticos).
# false = Modo LIVE READ-ONLY (consulta estrictamente datos reales de n8n Data Tables).
RUN_SYNTHETIC_TEST=true

# ------------------------------------------------------------------------------
# 2. IDENTIFICADORES DE DATA TABLES (Opcionales con valores predeterminados válidos)
# Ya cuentan con valores por defecto en el código del cliente.
# Solo configure estas variables si cambia la instancia o recrea las tablas.
# ------------------------------------------------------------------------------
N8N_TABLE_PROSPECTS=XXFhpG7YA3LLc0F4
N8N_TABLE_AUDITS=dpLz1QDQU3l4GyrP
N8N_TABLE_QUALIFICATIONS=GTtrgRiV4XxZijZZ
N8N_TABLE_ERRORS=Qig4adosI9vsNThw

# ------------------------------------------------------------------------------
# 3. IDENTIFICADORES DE WORKFLOWS Y PROYECTO (Opcionales)
# Workflows inactivos por diseño para control de seguridad.
# ------------------------------------------------------------------------------
N8N_PROJECT_ID=gpI1QfU4f7fk1cv8
N8N_WF01_ID=tTHszjE5cqMyK1iF
N8N_WF02_ID=KosNnbUlKPeKZXHh
N8N_WF03_ID=O4YiErQMAGK9yGPZ

# ------------------------------------------------------------------------------
# 4. SEGURIDAD INTERNA Y METADATOS PÚBLICOS
# ------------------------------------------------------------------------------
# Protección interna opcional de rutas
INTERNAL_DASHBOARD_KEY=

# Metadatos públicos de la aplicación
NEXT_PUBLIC_APP_NAME=ZYRVAE Intelligence Dashboard
NEXT_PUBLIC_APP_VERSION=1.0.0
