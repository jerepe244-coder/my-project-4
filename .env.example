# ==============================================================================
# ZYRVAE Intelligence Dashboard — Environment Variables Configuration
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings > Environment Variables.
# NEVER commit .env or .env.local with real credentials to Git.
# ==============================================================================

# n8n Cloud Instance Configuration (Server-side ONLY, never expose to client)
N8N_BASE_URL=https://zyrvae.app.n8n.cloud
N8N_API_KEY=

# n8n Project & Workflows Known Identifiers
N8N_PROJECT_ID=gpI1QfU4f7fk1cv8
N8N_WF01_ID=tTHszjE5cqMyK1iF
N8N_WF02_ID=KosNnbUlKPeKZXHh
N8N_WF03_ID=O4YiErQMAGK9yGPZ

# n8n Data Tables Identifiers
N8N_TABLE_PROSPECTS=XXFhpG7YA3LLc0F4
N8N_TABLE_AUDITS=dpLz1QDQU3l4GyrP
N8N_TABLE_QUALIFICATIONS=GTtrgRiV4XxZijZZ
N8N_TABLE_ERRORS=Qig4adosI9vsNThw

# Security & Data Mode
# When 'true', dashboard isolates test runs and provides full synthetic data.
# When 'false', queries the real n8n Cloud instance if credentials are valid.
RUN_SYNTHETIC_TEST=true

# Optional Internal Access Protection (HTTP Header / Bearer token or basic gate)
INTERNAL_DASHBOARD_KEY=

# Public Application Metadata
NEXT_PUBLIC_APP_NAME=ZYRVAE Intelligence Dashboard
NEXT_PUBLIC_APP_VERSION=1.0.0
